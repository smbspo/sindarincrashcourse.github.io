function showDefinition(verbInput) {
  const cleanedVerb = verbInput.replace(/-+$/, '');
  const entry = verbDictionary[cleanedVerb];

  const output = document.getElementById('definition-output');

  if (!entry) {
    output.textContent = "Definition not found.";
    return;
  }

  let html = `
    <strong>Definition:</strong> ${entry.definition}<br>
    ${entry.stem ? `<strong>Stem:</strong> ${entry.stem}<br>` : ''}
  `;

  if (entry.english) {
    html += `
      <div style="margin-top: 0.75em;">
        <strong>English Meanings:</strong><br>
        <strong>Present:</strong> ${entry.english.present.join(", ")}<br>
        <strong>Past:</strong> ${entry.english.past.join(", ")}<br>
        <strong>Future:</strong> ${entry.english.future.join(", ")}<br>
        <strong>Gerund:</strong> ${entry.english.gerund.join(", ")}<br>
        <strong>Imperative:</strong> ${entry.english.imperative.join(", ")}<br>
        <strong>Infinitive:</strong> ${entry.english.infinitive.join(", ")}<br>
        <strong>Present Active Participle:</strong> ${entry.english.presentActiveParticiple.join(", ")}<br>
        <strong>Past Active Participle:</strong> ${entry.english.pastActiveParticiple.join(", ")}<br>
        <strong>Passive Past Participle Singular:</strong> ${entry.english.passivePastParticipleSingular.join(", ")}<br>
        <strong>Passive Past Participle Plural:</strong> ${entry.english.passivePastParticiplePlural.join(", ")}
      </div>
    `;
  }

  output.innerHTML = html;
}
